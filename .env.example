# ==========================================
# Bangla Dialect Translator - Frontend Config Example
# ==========================================

# Backend API Base URL
# Leave empty for local development (Vite proxies /api to http://localhost:8000)
# In production (Vercel/Netlify), set to your live backend URL (e.g. https://bangla-dialect-api-backend.onrender.com)
VITE_API_BASE_URL=

# Default Hugging Face Model Repository ID
VITE_DEFAULT_HF_REPO=samim5669/banglat5-dialect-to-standard
